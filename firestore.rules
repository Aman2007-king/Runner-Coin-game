// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// Collection: leaderboard
// Document ID: auto-generated
// Fields:
//   - name: string (required, 1-30 chars) - Player's display name
//   - score: number (required, positive) - Player's high score
//   - timestamp: timestamp (required) - When the score was recorded
//
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         (request.auth.token.email == "ry650506@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll(['name', 'score', 'timestamp']) &&
             data.keys().hasOnly(['name', 'score', 'timestamp']) &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 30 &&
             data.score is number && data.score >= 0 &&
             data.timestamp is timestamp;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /leaderboard/{entryId} {
      // Allow anyone to read the leaderboard (Global rankings)
      // We explicitly allow unauthenticated read here as it's a public feature
      allow read: if true;
      
      // Allow authenticated users to submit scores
      allow create: if isAuthenticated() && isValidLeaderboardEntry(request.resource.data);
      
      // Prevent updates or deletes to maintain leaderboard integrity
      allow update, delete: if isAdmin();
    }

    // Default deny
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
