{
  "entities": {
    "LeaderboardEntry": {
      "title": "Leaderboard Entry",
      "description": "A high score entry on the global leaderboard",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the player"
        },
        "score": {
          "type": "number",
          "description": "The score achieved"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "When the score was achieved"
        }
      },
      "required": ["name", "score", "timestamp"]
    }
  },
  "firestore": {
    "/leaderboard/{entryId}": {
      "schema": "LeaderboardEntry",
      "description": "Collection of global high scores"
    }
  }
}
